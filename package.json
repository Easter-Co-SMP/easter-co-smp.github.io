{
  "name": "easter-company-launcher",
  "version": "1.0.13",
  "description": "Easter Company Minecraft launcher, world map and crew companion",
  "main": "desktop/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/desktop/*.test.cjs tests/wiki.test.mjs",
    "test:desktop": "xvfb-run -a node tests/desktop/electron.mjs",
    "test:site": "node tests/browser.mjs",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Easter-Co-SMP/easter-co-smp.github.io.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/Easter-Co-SMP/easter-co-smp.github.io/issues"
  },
  "homepage": "https://github.com/Easter-Co-SMP/easter-co-smp.github.io#readme",
  "dependencies": {
    "@xmcl/core": "2.14.1",
    "@xmcl/installer": "6.1.0",
    "@xmcl/task": "4.1.1",
    "undici": "7.30.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "@xmcl/unzip": "2.1.2",
    "@xmcl/file-transfer": "2.1.4"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "author": {
    "name": "Easter LTD"
  },
  "license": "UNLICENSED",
  "private": true,
  "build": {
    "appId": "ltd.easter.company.launcher",
    "productName": "Easter Co. Launcher",
    "copyright": "Copyright © Easter LTD. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "files": [
      "desktop/*.cjs",
      "site/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Game",
      "icon": "desktop/icon.png",
      "executableName": "easter-company",
      "artifactName": "Easter-Company-Linux-${arch}.${ext}",
      "maintainer": "Easter LTD",
      "desktop": {
        "entry": {
          "StartupWMClass": "electron"
        }
      }
    },
    "pacman": {
      "depends": [
        "glibc",
        "gtk3",
        "nss",
        "nspr",
        "alsa-lib",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "glib2",
        "hicolor-icon-theme",
        "libcups",
        "libdrm",
        "libnotify",
        "libpulse",
        "libstdc++",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "libxss",
        "mesa",
        "pango",
        "systemd-libs",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Easter-Company-Windows-${arch}.${ext}",
      "legalTrademarks": "Easter Company is a trading name of Easter LTD."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Easter Co. Launcher"
    }
  }
}
